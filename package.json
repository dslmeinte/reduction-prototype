{
    "name": "reduction-prototype",
    "version": "0.0.0-dev",
    "description": "PoC around an approach for reduction that combines validation and interpretation",
    "license": "Apache-2.0",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/dslmeinte/reduction-prototype.git"
    },
    "devDependencies": {
        "@eslint/eslintrc": "3.3.3",
        "@eslint/js": "9.39.2",
        "@typescript-eslint/eslint-plugin": "8.52.0",
        "@typescript-eslint/parser": "8.52.0",
        "rimraf": "6.1.2",
        "typescript": "5.9.3"
    },
    "scripts": {
        "clean": "npm run clean -w packages --if-present && npx --yes rimraf node_modules",
        "initialize": "npm run clean && npm install",
        "build": "npm run build -w packages --if-present",
        "test": "npm run test -w packages --if-present",
        "lint": "npm run lint -w packages --if-present"
    },
    "private": true,
    "workspaces": [
        "./packages/build",
        "./packages/prototype"
    ]
}
